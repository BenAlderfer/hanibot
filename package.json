{
  "name": "rbc-bot",
  "description": "RBC Discord bot",
  "engines": {
    "node": "26.x"
  },
  "main": "build/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "compile": "tsc -p .",
    "test": "TS_NODE_PROJECT=tsconfig.test.json mocha --require ts-node/register --extension ts \"test/**/*.spec.ts\" --exit",
    "format": "prettier --ignore-path .prettierignore --write \"**/*.+(js|ts|json)\"",
    "lint": "eslint .",
    "prettier-fix": "prettier --write ."
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/sinon": "^22.0.2",
    "@types/sinon-chai": "^4.0.1",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "private": true
}
