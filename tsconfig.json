{
  "compilerOptions": {
    "target": "es2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "esModuleInterop": true,
    "strict": true,
    // @types/node@26 dropped util.InspectOptionsStylized, which @sapphire/shapeshift@4
    // (via discord.js -> @discordjs/builders@1.x) imports. Remove once discord.js moves to shapeshift >=5.
    "skipLibCheck": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "build"
  },
  "include": ["src"],
  "exclude": ["node_modules", "build", "test"]
}
